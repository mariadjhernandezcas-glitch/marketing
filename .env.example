# Triario Implementation Portal - environment variables
#
# Estas variables solo se usan server-side (nunca con prefijo NEXT_PUBLIC_)
# para evitar exponer secretos en el bundle del cliente.
# No incluyas credenciales reales en este archivo.

# Token privado de la app HubSpot (Private App Access Token).
# Se usará server-side por HubSpotTicketRepository cuando se conecte HubSpot.
HUBSPOT_ACCESS_TOKEN=

# ID del pipeline de HubSpot donde viven los tickets de implementación.
HUBSPOT_TICKET_PIPELINE_ID=
