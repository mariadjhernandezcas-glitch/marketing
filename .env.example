# Copia este archivo a .env.local y completa los valores para habilitar el
# envío de correos. Si estas variables no están configuradas, la app sigue
# funcionando normalmente pero solo deja un registro en consola en lugar de
# enviar el correo (útil para desarrollo local).

# Servidor SMTP (ej. smtp.gmail.com, smtp.office365.com, tu proveedor transaccional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Remitente que verán los destinatarios (opcional, por defecto usa SMTP_USER)
SMTP_FROM="Tickets Hommik <tickets@tudominio.com>"

# Correo interno que recibe copia de cada ticket nuevo y cada cambio de etapa
TEAM_NOTIFY_EMAIL=

# URL pública de la app, para incluir enlaces "Ver ticket" en los correos
APP_BASE_URL=http://localhost:3000

# Carpeta donde se guarda la base de datos SQLite (opcional, por defecto ./data)
TICKETS_DATA_DIR=./data
