# Copia este archivo a .env.local y completa los valores.
# En Vercel, POSTGRES_URL se inyecta automáticamente al conectar una base de
# datos Postgres en la pestaña Storage — normalmente no hace falta ponerla
# a mano ahí. Para desarrollo local sí necesitas apuntar a una base propia
# (por ejemplo una gratuita en https://neon.tech, o `vercel env pull` si el
# proyecto ya está conectado en Vercel).
POSTGRES_URL=

# Variables de correo: si no están configuradas, la app sigue funcionando
# normalmente pero solo deja un registro en consola en lugar de enviar el
# correo (útil para desarrollo local).

# Servidor SMTP (ej. smtp.gmail.com, smtp.office365.com, tu proveedor transaccional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Remitente que verán los destinatarios (opcional, por defecto usa SMTP_USER)
SMTP_FROM="Tickets Hommik <tickets@tudominio.com>"

# Correo interno que recibe copia de cada ticket nuevo y cada cambio de etapa
TEAM_NOTIFY_EMAIL=

# URL pública de la app, para incluir enlaces "Ver ticket" en los correos
APP_BASE_URL=http://localhost:3000
